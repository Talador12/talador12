# Copy to ~/.zsh/secrets.zsh and fill in values.
# NEVER commit secrets.zsh — it is local-only and not symlinked.

# werk LDAP (corp.geico.net password)
# export WERK_LDAP_PASSWORD='...'

# Azure / internal APIs
# export GEICO_TENANT='...'
# export NAAS_APP_ID='...'
# export SEAMSTRESS_APP_ID=$NAAS_APP_ID

# Other tokens as needed
# export KUBECOST_API_KEY='...'
