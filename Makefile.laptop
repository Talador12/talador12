MAKEFLAGS += --no-print-directory --warn-undefined-variables --output-sync=target

# Laptop runbook — single source of truth (public).
# Work-specific targets: ~/.zsh/laptop.mk (local, not committed).
# New projects: copy Makefile.template, not this file.

-include $(HOME)/.zsh/laptop.mk

################################################################################
#                                 Variables                                    #
################################################################################

SHELL := /bin/bash
PROJECT_NAME := laptop
REPOS_PERSONAL := $(HOME)/repos/talador12
PROFILE_REPO   := $(REPOS_PERSONAL)/talador12
GH_USER_PERSONAL := Talador12
GH_PROTOCOL      := https

################################################################################
#                                 Meta                                         #
################################################################################

.DEFAULT_GOAL := help
.PHONY: help makeinfo

################################################################################
#                                 Setup                                        #
################################################################################

setup: makeinfo ## [Setup] Full laptop bootstrap
	$(MAKE) setup-shell
	$(MAKE) symlink-dotfiles
	$(MAKE) setup-dev-tools
	$(MAKE) github-setup
	@echo ""
	@echo "  Done. Open a new terminal (exec zsh). Run p10k configure if prompted."
	@echo ""

status: makeinfo ## [Monitor] Shell, toolchains, GitHub, repo dirs
	@echo ""
	@echo "  Shell: $$(zsh --version 2>/dev/null || echo 'not found')"
	@if [ -d "$(HOME)/.oh-my-zsh" ]; then echo "  oh-my-zsh: installed"; else echo "  oh-my-zsh: missing → make setup-shell"; fi
	@if [ -f "$(HOME)/.p10k.zsh" ]; then echo "  p10k: configured"; else echo "  p10k: run p10k configure"; fi
	@echo ""
	@echo "  Toolchains:"
	@command -v uv >/dev/null && echo "    python: $$(uv run python --version 2>/dev/null)" || echo "    python: missing → make setup-dev-tools"
	@command -v go >/dev/null && echo "    go:     $$(go version 2>/dev/null | awk '{print $$3}')" || echo "    go:     missing"
	@. "$(HOME)/.cargo/env" 2>/dev/null; command -v rustc >/dev/null && echo "    rust:   $$(rustc --version 2>/dev/null | awk '{print $$2}')" || echo "    rust:   missing"
	@command -v bun >/dev/null && echo "    bun:    $$(bun --version 2>/dev/null)" || echo "    bun:    missing"
	@echo ""
	@echo "  GitHub:"
	@gh auth status 2>&1 | sed 's/^/    /' || echo "    not logged in → make github-login"
	@echo ""
	@echo "  personal repos: $$(ls -1 '$(REPOS_PERSONAL)' 2>/dev/null | wc -l | tr -d ' ')"
	@$(MAKE) -s status-work 2>/dev/null || true
	@echo ""

################################################################################
#                                GitHub                                        #
################################################################################

github-setup: makeinfo ## [GitHub] Configure gh credential helper + HTTPS
	@command -v gh >/dev/null || { echo "ERROR: brew install gh"; exit 1; }
	@gh auth setup-git
	@gh config set -h github.com git_protocol $(GH_PROTOCOL)
	@gh auth status 2>&1 | sed 's/^/  /'

github-login: makeinfo ## [GitHub] Interactive login (run per account)
	gh auth login

github-test: makeinfo ## [GitHub] Verify personal account over HTTPS
	@gh auth switch -u $(GH_USER_PERSONAL) >/dev/null
	@gh api user --jq .login | grep -q $(GH_USER_PERSONAL) && echo "  ✓ $(GH_USER_PERSONAL)"

github-test-ssh: makeinfo ## [GitHub] Test personal SSH (off VPN)
	@ssh -T -o ConnectTimeout=10 git@github.com-personal 2>&1 || true

github-keys: makeinfo ## [GitHub] Print personal SSH public key
	@cat $(HOME)/.ssh/id_ed25519_personal.pub 2>/dev/null || echo "  missing"

gh-personal: makeinfo ## [GitHub] Switch to Talador12
	@gh auth switch -u $(GH_USER_PERSONAL)

clone-personal: makeinfo ## [GitHub] Clone: make clone-personal REPO=Talador12/foo
	@[ -n "$(REPO)" ] || { echo "Usage: make clone-personal REPO=Talador12/foo"; exit 1; }
	@gh auth switch -u $(GH_USER_PERSONAL)
	@git clone "https://github.com/$(REPO).git" "$(REPOS_PERSONAL)/$$(basename $(REPO))"

################################################################################
#                                 Shell                                        #
################################################################################

setup-shell: makeinfo ## [Shell] Install oh-my-zsh, p10k, plugins, fonts
	@brew install figlet eza 2>/dev/null || brew install figlet eza
	@brew install --cask font-meslo-lg-nerd-font 2>/dev/null || true
	@if [ ! -d "$(HOME)/.oh-my-zsh" ]; then \
		RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"; \
	fi
	@ZSH_CUSTOM="$(HOME)/.oh-my-zsh/custom"; \
	[ -d "$$ZSH_CUSTOM/themes/powerlevel10k" ] || git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$$ZSH_CUSTOM/themes/powerlevel10k"; \
	[ -d "$$ZSH_CUSTOM/plugins/zsh-autosuggestions" ] || git clone https://github.com/zsh-users/zsh-autosuggestions "$$ZSH_CUSTOM/plugins/zsh-autosuggestions"; \
	[ -d "$$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ] || git clone https://github.com/zsh-users/zsh-syntax-highlighting "$$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"
	@mkdir -p $(HOME)/.zsh

symlink-dotfiles: makeinfo ## [Shell] Symlink ~/Makefile, ~/.zshrc, ~/AGENTS.md, ~/claude.md → repo
	@for pair in \
		"$(HOME)/Makefile:$(PROFILE_REPO)/Makefile" \
		"$(HOME)/.zshrc:$(PROFILE_REPO)/.zshrc" \
		"$(HOME)/AGENTS.md:$(PROFILE_REPO)/AGENTS.md" \
		"$(HOME)/claude.md:$(PROFILE_REPO)/claude.md"; do \
		link=$${pair%%:*}; target=$${pair#*:}; \
		[ -e "$$target" ] || { echo "ERROR: $$target missing"; exit 1; }; \
		if [ -L "$$link" ] && [ "$$(readlink "$$link")" = "$$target" ]; then echo "  $$link ok"; \
		elif [ -e "$$link" ]; then cp "$$link" "$$link.bak.$$(date +%Y%m%d)"; rm "$$link"; ln -s "$$target" "$$link"; echo "  $$link → $$target"; \
		else ln -s "$$target" "$$link"; echo "  $$link → $$target"; fi; \
	done

shell-check: makeinfo ## [Shell] Verify zsh loads cleanly
	@zsh -lic 'typeset -f gh-personal >/dev/null && echo "  shell ok"'

################################################################################
#                              Dev Toolchains                                  #
################################################################################

setup-dev-tools: makeinfo ## [Dev] Install uv, rustup, mise (go), bun
	@brew install uv mise bun 2>/dev/null || brew install uv mise bun
	@mkdir -p $(HOME)/.config/mise
	@printf '%s\n' '[tools]' 'go = "latest"' > "$(HOME)/.config/mise/config.toml"
	@mise install -y
	@command -v rustc >/dev/null || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
	@uv python install 3 --default 2>&1 || uv python install 3.13 2>&1
	@uv python update-shell 2>&1 || true

dev-tools-status: makeinfo ## [Dev] Show Python, Go, Rust, Node versions
	@$(MAKE) status

dev-tools-update: makeinfo ## [Dev] Upgrade all toolchains
	@uv python install 3 --reinstall 2>&1 || true
	@mise upgrade 2>&1 || true
	@. "$(HOME)/.cargo/env" 2>/dev/null; rustup update stable 2>&1 || true
	@brew upgrade bun 2>&1 || true

################################################################################
#                              Help & Info                                     #
################################################################################

tree: makeinfo ## [Utility] Directory tree
	@tree -I 'node_modules|.git|dist|.next|.turbo|.vite|venv|__pycache__|target' -L 5 2>/dev/null || echo "  brew install tree"

help:
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "} {printf "%s %03d:## %s\n", $$1, length($$1), $$2}' | sort -k1,1 -k2,2n | awk -F':## ' '{split($$1, parts, " "); printf "\033[36m%-22s\033[0m %s\n", parts[1], $$2}'

MAKECMDGOALS ?=

makeinfo:
	@goal="$(MAKECMDGOALS)"; \
	if [ "$$goal" = "" ] || [ "$$goal" = "makeinfo" ] || [ "$$goal" = "help" ]; then exit 0; fi; \
	echo "" 1>&2; \
	echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" 1>&2; \
	echo "  Running: $$goal" 1>&2; \
	echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" 1>&2; \
	echo "" 1>&2
